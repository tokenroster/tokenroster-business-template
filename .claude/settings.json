{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-read-paths.js",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-bash-paths.js",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
